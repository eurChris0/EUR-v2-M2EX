::EUR.revive_sett <- null       // mutated across functions -> globals (Quirrel upvalues capture by value)
::EUR.revive_faction <- null

::EUR.eurReviveFaction <- function(faction, sett, bool) {
    ::game.campaign().setEventCounter("faction_spawning", 1)
    faction.isHorde = true
    ::EUR.eur_sMap.findSettlement(::EUR.faction_revival[faction.name].capital).changeOwner(faction, false)

    if ((faction.name in ::EUR.gen_units_list) && faction.capital) {
        local army = ::EUR.eurSpawnArmy(faction.name, "random_name", faction.name + "revival_", "", true, 30,
            ::EUR.leaderheir_combi_list[faction.name].leader.unit, sett.tileX, sett.tileY, 7, 1, 0)
        if (army) {
            local roster = ::EUR.gen_units_list[faction.name]
            for (local i = 0; i < 2; i++) { army.createUnit(roster["special"][0], 5, 0, 0, -1) }
            for (local i = 0; i < 4; i++) { army.createUnit(roster["T3"][::EUR.math.random(0, roster["T3"].len() - 1)], 3, 0, 0, -1) }
            for (local i = 0; i < 6; i++) { army.createUnit(roster["T2"][::EUR.math.random(0, roster["T2"].len() - 1)], 2, 0, 0, -1) }
            for (local i = 0; i < 5; i++) { army.createUnit(roster["T1"][::EUR.math.random(0, roster["T1"].len() - 1)], 1, 0, 0, -1) }

            if (army.leader != null && army.leader.record != null) {
                local char = army.leader.record
                char.addTrait("AIBoost", 1)
                char.addTrait("Locked", 1)
                char.addTrait("BattleScarred", 2)
                char.addTrait("FactionLeader", 1)
                char.addTrait("GoodAmbusher", 1)
                char.addTrait("GoodCommander", 3)
                char.addTrait("Loyal", 1)
                char.addTrait("LoyaltyStarter", 1)
                char.addTrait("PietyStarter", 1)
                char.addTrait("NaturalMilitarySkill", 1)
                char.addTrait("NaturalManagementSkill", 1)
            }
            if (!::EUR.game_options.unlimited_revival) { ::EUR.faction_revival[faction.name].revived_already = true }
            if (!bool) {
                if (!::EUR.game_options.unlimited_revival) { ::EUR.faction_revival[faction.name].revived_already_ai = true }
                ::game.showHistoricEvent("faction_prosperous_other", "Faction Revived",
                    faction.displayName + " has revived! These people have returned from the embers of history and under their new leader "
                    + army.leader.record.displayName + " seek to rebuild and bring vengance upon those who sought to vanquish them.")
            }
        }
    }

    if (bool) {
        ::EUR.eur_campaign.setStance(::Enum.DiplomaticRelation.alliance, ::EUR.eur_player_faction, faction)
        ::game.runConsoleCommand("add_money", "-" + ::EUR.game_options.revival_cost)
    }
    faction.isHorde = false
    ::EUR.revive_sett = null
    ::EUR.revive_faction = null
    ::game.campaign().setEventCounter("faction_spawning", 0)
}

::EUR.checkAIRevival <- function() {
    for (local i = 0; i < ::EUR.eur_campaign.factionCount; i++) {
        local faction = ::EUR.eur_campaign.factionByOrder(i)
        if (faction.isPlayerControlled != 0) continue
        if (faction.characterCount != 0) continue
        if (!(faction.name in ::EUR.faction_revive_ai) || !::EUR.faction_revive_ai[faction.name]) continue
        if (::EUR.faction_revival[faction.name].revived_already_ai || ::EUR.faction_revival[faction.name].revived_already) continue

        local sett = ::EUR.eur_sMap.findSettlement(::EUR.faction_revival[faction.name].capital)
        if (sett == null || sett.siegeCount != 0 || sett.owner == ::EUR.eur_player_faction) continue
        if (::EUR.randomChance(1)) { ::EUR.eurReviveFaction(faction, sett, false) }
    }
}

class eurReviveUI {
    // Authored against the GAME's 1024x768 space, like every other HUD-anchored EUR button.
    layout = {
        buttonX = 1170, buttonY = 210, buttonSize = 50,
    }

    choiceScroll = null
    contentCanvas = 0
    buttonCanvas = 0
    yesButton = 0
    noButton = 0
    built = false

    function ensure() {
        if (this.built) return
        this.built = true
        local self = this
        ::UI.pushStyle(::EUR.eurStyles.basic_4)

        this.choiceScroll = ::EUR.scroll.create(610, 310, 207, 229, function() { ::EUR.show_revive_choice = false })
        this.contentCanvas = ::UI.canvas(0, 0)
        ::UI.canvasDraw(this.contentCanvas, function() { self.drawChoiceContent() })

        this.yesButton = ::UI.button("Yes", 90, 40)
        ::UI.placeAbsolute(this.yesButton)
        ::UI.buttonClick(this.yesButton, function() {
            ::EUR.show_revive_choice = false
            ::EUR.eurReviveFaction(::EUR.revive_faction, ::EUR.revive_sett, true)
            ::game.runScriptCommand("play_sound_event", "BUTTON_DOWN")
        })
        this.noButton = ::UI.button("No", 90, 40)
        ::UI.placeAbsolute(this.noButton)
        ::UI.buttonClick(this.noButton, function() {
            ::EUR.show_revive_choice = false
            ::game.runScriptCommand("play_sound_event", "BUTTON_DOWN")
        })

        ::UI.setParent(0)
        this.buttonCanvas = ::UI.canvas(this.layout.buttonSize, this.layout.buttonSize,
                                        this.layout.buttonX, this.layout.buttonY)
        ::UI.canvasDraw(this.buttonCanvas, function() { self.drawButton() })

        ::UI.popStyle()
        ::UI.setParent(0)
        ::UI.widgetVisible(this.choiceScroll.window, false)
        ::UI.widgetVisible(this.yesButton, false)
        ::UI.widgetVisible(this.noButton, false)
    }

    function render() {
        this.ensure()
        ::UI.widgetVisible(this.choiceScroll.window, ::EUR.show_revive_choice && ::EUR.in_campaign_map)
        this.positionButtons()
    }

    function positionButtons() {
        local visible = ::EUR.show_revive_choice && ::EUR.revive_faction != null && ::EUR.revive_sett != null
        ::UI.widgetVisible(this.yesButton, visible)
        ::UI.widgetVisible(this.noButton, visible)
        if (!visible) return

        local rect = ::UI.widgetRectGet(this.choiceScroll.window)
        if (rect == null) return
        local margins = ::EUR.scroll.setMargins("scroll")
        local areaX = rect[0] + margins[0]
        local areaWidth = rect[2] - margins[0] - margins[2]
        local buttonY = rect[1] + rect[3] - margins[3] - 60

        ::UI.widgetRect(this.yesButton, areaX + areaWidth / 4 - 45, buttonY, 90, 40)
        ::UI.widgetRect(this.noButton, areaX + areaWidth * 3 / 4 - 45, buttonY, 90, 40)
    }

    function drawButton() {
        if (!::EUR.in_campaign_map) return
        local scroll = ::ui.settlementScroll()
        if (scroll == null || scroll.settlement == null) return
        local sett = scroll.settlement
        if (!(sett.name in ::EUR.capital_cities)) return
        local reviveName = ::EUR.capital_cities[sett.name]
        if (::EUR.eur_campaign.factionByName(reviveName).characterCount != 0) return
        if (::EUR.faction_revival[reviveName].revived_already) return
        if (!::EUR.tableContains(::EUR.faction_revival[reviveName].revived_by, ::EUR.faction_disposition[::EUR.eur_player_faction.name])) return
        if (::EUR.eur_player_faction.capital.name == reviveName) return

        local canAfford = ::EUR.eur_player_faction.money >= ::EUR.game_options.revival_cost
        local icon = canAfford ? ::EUR.revive_yes : ::EUR.revive_no
        if (icon == null) return

        if (::UI.imageButton(icon.img, this.layout.buttonSize, this.layout.buttonSize,
                             this.layout.buttonX, this.layout.buttonY).clicked && canAfford && !::EUR.show_revive_choice) {
            ::EUR.show_revive_choice = true
            ::EUR.revive_sett = sett
            ::EUR.revive_faction = ::EUR.eur_campaign.factionByName(reviveName)
            ::game.runScriptCommand("play_sound_event", "STRAT_SCROLL_OPENS")
        }
    }

    function drawChoiceContent() {
        if (!::EUR.show_revive_choice || ::EUR.revive_faction == null || ::EUR.revive_sett == null) return
        local rect = ::UI.widgetRectGet(this.choiceScroll.window)
        if (rect == null) return
        local margins = ::EUR.scroll.setMargins("scroll")
        local areaX = rect[0] + margins[0]
        local areaY = rect[1] + margins[1]
        local areaWidth = rect[2] - margins[0] - margins[2]

        ::UI.layoutAt(areaX, areaY + 30)
        ::UI.pushStyle({ [::UI.Metric.fontSize] = 18, [::UI.Metric.alignX] = 1, [::UI.Metric.elideWidth] = areaWidth })
        ::UI.text("Revive " + ::EUR.revive_faction.displayName + "?")
        ::UI.popStyle()

        ::UI.layoutAt(areaX, areaY + 90)
        ::UI.pushStyle({ [::UI.Metric.alignX] = 1, [::UI.Metric.elideWidth] = areaWidth })
        ::UI.text("Cost: " + ::EUR.game_options.revival_cost)
        ::UI.popStyle()
    }
}

::EUR.eurReviveUI <- eurReviveUI()
::UI.onFrame(function() { ::EUR.eurReviveUI.render() })
