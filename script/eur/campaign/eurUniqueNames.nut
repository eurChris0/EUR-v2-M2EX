::EUR.checked_labels <- {}

::EUR.fixCharUniqueName <- function(char) {
    if (char == null || char.label == null) return
    if (char.label in ::EUR.checked_labels) return
    ::EUR.checked_labels[char.label] <- true

    if (!(char.shortName in ::EUR.unique_names)) return
    local labels = ::EUR.unique_names[char.shortName]
    foreach (label in labels) {
        if (char.label.indexof(label) != null) return   // already a legitimate variant of this name
    }
    if (char.character != null && char.character.faction != null) {
        char.randomiseName(char.character.faction.id)
    }
}
