            EDUOFFET_VARS_LEG = ::EUR.EDUOFFET_VARS_LEG,
            eregion_realms_start = ::EUR.eregion_realms_start,
            eregion_realms_sett_taken = ::EUR.eregion_realms_sett_taken,
