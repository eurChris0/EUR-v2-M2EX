      VALUE "InternalName", "M2EXLauncher"
      VALUE "OriginalFilename", "M2TWEOP_GUI.exe"
      VALUE "ProductName", "M2EX Launcher"
      VALUE "ProductVersion", "1.0.0"
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x409, 1200
  END
END
